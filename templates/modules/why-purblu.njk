<section class="module shell" aria-labelledby="why-title">
  <div class="section-heading"><p class="eyebrow">{{ eyebrow }}</p><h2 id="why-title">{{ headline }}</h2><div class="module-copy">{{ content | safe }}</div></div>
  <div class="reason-grid">
    <article class="reason"><span class="reason-number">01</span><h3>Raised nearby</h3><p>Our shrimp grow in indoor tanks right here in Jordan, Minnesota.</p></article>
    <article class="reason"><span class="reason-number">02</span><h3>Direct from the grower</h3><p>Local pickup connects you with the people raising and harvesting your food.</p></article>
    <article class="reason"><span class="reason-number">03</span><h3>Know the process</h3><p>Our feed contains no antibiotics. At harvest, we net, chill, sort, package, and keep the shrimp on ice.</p></article>
  </div>
</section>
