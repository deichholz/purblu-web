<section class="module harvest-module" aria-labelledby="harvest-title">
  <div class="shell harvest-grid">
    <div><p class="eyebrow eyebrow-light">{{ eyebrow }}</p><h2 id="harvest-title">{{ headline }}</h2><div class="module-copy">{{ content | safe }}</div></div>
    <div class="harvest-card" aria-label="Harvest details">
      <p class="harvest-date"><span>{{ harvest.displayDate }}</span><small>{{ harvest.pickupWindow }} · Jordan pickup</small></p>
      <dl class="harvest-facts"><div><dt>Price</dt><dd>{{ harvest.pricePerPound | money }}/lb</dd></div><div><dt>Packages</dt><dd>{% for pounds in harvest.packagePounds %}{{ pounds }} lb{% if not loop.last %} · {% endif %}{% endfor %}</dd></div><div><dt>Product</dt><dd>Whole, head-on, shell-on</dd></div></dl>
      <a class="button coral" href="/pre-orders/index.html">View harvest details <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
