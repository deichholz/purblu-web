<section class="about-story{% if reverse %} reverse{% endif %}"><div class="shell about-story-grid">
  <figure class="module-image"><img src="{{ image }}" width="{{ imageWidth }}" height="{{ imageHeight }}" loading="lazy" alt="{{ imageAlt }}"></figure>
  <div><p class="eyebrow">{{ eyebrow }}</p><h2>{{ headline }}</h2><div class="about-copy">{{ content | safe }}</div></div>
</div></section>
